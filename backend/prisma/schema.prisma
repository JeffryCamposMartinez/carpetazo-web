// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  firebaseUid String @unique
  email     String   @unique
  name      String?
  username  String?  @unique
  photoURL  String?
  folders   Folder[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Folder {
  totalVisits   Int      @default(0)
  weeklyVisits  Int      @default(0)
  lastVisitWeek Int      @default(0)
  id          String   @id @default(uuid())
  name        String
  description String?
  tcg         String   @default("Pokemon")
  color       String   @default("red")
  isPublic    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Card {
  id        String   @id @default(uuid())
  tcgId     String   // The ID from the TCG API
  name      String
  imageUrl  String?
  price     Float?
  stock     Int      @default(1)
  data      Json?
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  receiverId String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Order {
  id          String   @id @default(uuid())
  sellerId    String
  buyerName   String
  folderId    String
  folderName  String
  items       Json
  total       Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TcgCategory {
  blocks      TcgBlock[]
  categoryId  Int       @id
  name        String
  modifiedOn  DateTime
  groups      TcgGroup[]
}

model TcgGroup {
  blockId     Int?
  block       TcgBlock?   @relation(fields: [blockId], references: [id])
  groupId     Int       @id
  categoryId  Int
  name        String
  publishedOn DateTime
  modifiedOn  DateTime
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  products    TcgProduct[]
}

model TcgProduct {
  physicalProductId Int?
  physicalProduct   TcgPhysicalProduct? @relation(fields: [physicalProductId], references: [id])
  productId   Int       @id
  groupId     Int
  categoryId  Int
  name        String
  cleanName   String
  imageUrl    String
  extData     Json?
  group       TcgGroup  @relation(fields: [groupId], references: [groupId])
}

model TcgBlock {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  name        String
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  groups      TcgGroup[]
}

model TcgPhysicalProduct {
  id          Int       @id @default(autoincrement())
  name        String
  releaseDate DateTime?
  products    TcgProduct[]
}