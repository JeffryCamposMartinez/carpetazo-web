// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  email         String   @unique
  role          String   @default("user")
  name          String?
  fullName      String?
  username      String?  @unique
  photoURL      String?
  bannerBase64  String?
  wallpaperBase64 String?
  bannerDominantColor String?
  bannerComplementaryColor String?
  bio           String?
  phone         String?
  rut           String?
  facebookUrl   String?
  instagramUrl  String?
  youtubeUrl    String?
  publicTheme   Json?
  addresses     Json?
  bankDetails   Json?
  folders       Folder[]
  wishlist      WishlistItem[]
  reviewsReceived SellerReview[] @relation("ReviewsReceived")
  reviewsWritten  SellerReview[] @relation("ReviewsWritten")
  reviewReports   ReviewReport[]
  termsAcceptances TermsAcceptance[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Folder {
  totalVisits   Int      @default(0)
  weeklyVisits  Int      @default(0)
  lastVisitWeek Int      @default(0)
  id          String   @id @default(uuid())
  name        String
  description String?
  tcg         String   @default("Pokemon")
  color       String   @default("red")
  isPublic    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic, createdAt])
}

model Card {
  id        String   @id @default(uuid())
  tcgId     String   // The ID from the TCG API
  name      String
  imageUrl  String?
  price     Float?
  stock     Int      @default(1)
  data      Json?
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([createdAt])
  @@index([tcgId])
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  receiverId String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead])
}

model Order {
  id          String   @id @default(uuid())
  code        String?  @unique
  sellerId    String
  buyerName   String
  buyerId     String?  // comprador con cuenta (pedidos por mensaje o con sesión iniciada): es quien puede calificar
  createdIpHash   String? // identificador anónimo (hash) de la conexión que creó el pedido
  completedIpHash String? // ídem, de la conexión que lo confirmó
  folderId    String
  folderName  String
  items       Json
  total       Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, status])
  @@index([folderId])
  @@index([buyerId])
}

model TcgCategory {
  blocks      TcgBlock[]
  categoryId  Int       @id
  name        String
  modifiedOn  DateTime
  groups      TcgGroup[]
  physicalProducts TcgPhysicalProduct[]
}

model TcgGroup {
  blockId     Int?
  block       TcgBlock?   @relation(fields: [blockId], references: [id])
  groupId     Int       @id
  categoryId  Int
  name        String
  publishedOn DateTime
  modifiedOn  DateTime
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  products    TcgProduct[]

  @@index([categoryId])
  @@index([blockId])
}

model TcgProduct {
  physicalProductId Int?
  physicalProduct   TcgPhysicalProduct? @relation(fields: [physicalProductId], references: [id])
  productId   String    @id
  groupId     Int
  categoryId  Int
  name        String
  cleanName   String
  imageUrl    String
  extData     Json?
  group       TcgGroup  @relation(fields: [groupId], references: [groupId])
  physicalLinks TcgProductPhysicalProduct[]

  @@index([groupId])
  @@index([categoryId, groupId])
  @@index([physicalProductId])
}

model TcgBlock {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  name        String
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  groups      TcgGroup[]
  physicalProducts TcgPhysicalProduct[]
}

// Producto físico (kit, display, colección…) de cualquier juego: pertenece a un juego y, si el juego los usa, a un bloque
model TcgPhysicalProduct {
  id          Int       @id @default(autoincrement())
  name        String
  releaseDate DateTime?
  categoryId  Int
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  blockId     Int?
  block       TcgBlock?   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  products    TcgProduct[]
  productLinks TcgProductPhysicalProduct[]

  @@unique([categoryId, blockId, name])
  @@index([categoryId])
  @@index([blockId])
}

// Una carta puede venir en varios productos físicos (kits, displays, colecciones): este enlace las une sin duplicar la carta
model TcgProductPhysicalProduct {
  productId         String
  physicalProductId Int
  product           TcgProduct         @relation(fields: [productId], references: [productId], onDelete: Cascade)
  physicalProduct   TcgPhysicalProduct @relation(fields: [physicalProductId], references: [id], onDelete: Cascade)

  @@id([productId, physicalProductId])
  @@index([physicalProductId])
}

// Cartas que un jugador busca. Se enlazan con el catálogo cuando existen allí; si no, se guardan con su nombre.
model WishlistItem {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   Int?
  productId    String?
  name         String
  game         String?
  detail       String?
  imageUrl     String?
  quantity     Int      @default(1)
  maxPrice     Float?
  priceVisible Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId, createdAt])
}

// Reseña de un comprador a un vendedor por un pedido completado. Una por pedido y no se edita.
model SellerReview {
  id         String   @id @default(uuid())
  sellerId   String
  seller     User     @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  orderId    String   @unique
  rating     Int
  comment    String?
  counts     Boolean  @default(true) // false: no se muestra ni promedia (sospechosa o reportada)
  flag       String?  // same_connection | reported
  reports    ReviewReport[]
  createdAt  DateTime @default(now())

  @@unique([sellerId, reviewerId]) // una reseña por pareja comprador-vendedor
  @@index([sellerId, createdAt])
  @@index([reviewerId])
}

// Denuncia de una reseña: mientras esté reportada deja de contar hasta que se revise
model ReviewReport {
  id         String       @id @default(uuid())
  reviewId   String
  review     SellerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String?
  createdAt  DateTime     @default(now())

  @@unique([reviewId, reporterId])
  @@index([reviewId])
}

// Aceptación de los Términos y Condiciones y de la Política de Privacidad (una fila por versión aceptada)
model TermsAcceptance {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion   String
  privacyVersion String
  isAdult        Boolean  @default(true)   // declaró tener 18 años o más
  connectionHash String?                   // hash de la conexión (con sal), no la IP
  acceptedAt     DateTime @default(now())

  @@index([userId, acceptedAt])
}
