// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  firebaseUid   String   @unique
  email         String   @unique
  role          String   @default("user")
  name          String?
  fullName      String?
  username      String?  @unique
  photoURL      String?
  bannerBase64  String?
  wallpaperBase64 String?
  bannerDominantColor String?
  bannerComplementaryColor String?
  bio           String?
  phone         String?
  rut           String?
  facebookUrl   String?
  instagramUrl  String?
  youtubeUrl    String?
  publicTheme   Json?
  addresses     Json?
  bankDetails   Json?
  folders       Folder[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Folder {
  totalVisits   Int      @default(0)
  weeklyVisits  Int      @default(0)
  lastVisitWeek Int      @default(0)
  id          String   @id @default(uuid())
  name        String
  description String?
  tcg         String   @default("Pokemon")
  color       String   @default("red")
  isPublic    Boolean  @default(true)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards       Card[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([isPublic, createdAt])
}

model Card {
  id        String   @id @default(uuid())
  tcgId     String   // The ID from the TCG API
  name      String
  imageUrl  String?
  price     Float?
  stock     Int      @default(1)
  data      Json?
  folderId  String
  folder    Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folderId])
  @@index([createdAt])
  @@index([tcgId])
}

model Message {
  id        String   @id @default(uuid())
  senderId  String
  receiverId String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead])
}

model Order {
  id          String   @id @default(uuid())
  code        String?  @unique
  sellerId    String
  buyerName   String
  folderId    String
  folderName  String
  items       Json
  total       Float
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sellerId, status])
  @@index([folderId])
}

model TcgCategory {
  blocks      TcgBlock[]
  categoryId  Int       @id
  name        String
  modifiedOn  DateTime
  groups      TcgGroup[]
  physicalProducts TcgPhysicalProduct[]
}

model TcgGroup {
  blockId     Int?
  block       TcgBlock?   @relation(fields: [blockId], references: [id])
  groupId     Int       @id
  categoryId  Int
  name        String
  publishedOn DateTime
  modifiedOn  DateTime
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  products    TcgProduct[]

  @@index([categoryId])
  @@index([blockId])
}

model TcgProduct {
  physicalProductId Int?
  physicalProduct   TcgPhysicalProduct? @relation(fields: [physicalProductId], references: [id])
  productId   String    @id
  groupId     Int
  categoryId  Int
  name        String
  cleanName   String
  imageUrl    String
  extData     Json?
  group       TcgGroup  @relation(fields: [groupId], references: [groupId])
  physicalLinks TcgProductPhysicalProduct[]

  @@index([groupId])
  @@index([categoryId, groupId])
  @@index([physicalProductId])
}

model TcgBlock {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  name        String
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  groups      TcgGroup[]
  physicalProducts TcgPhysicalProduct[]
}

// Producto físico (kit, display, colección…) de cualquier juego: pertenece a un juego y, si el juego los usa, a un bloque
model TcgPhysicalProduct {
  id          Int       @id @default(autoincrement())
  name        String
  releaseDate DateTime?
  categoryId  Int
  category    TcgCategory @relation(fields: [categoryId], references: [categoryId])
  blockId     Int?
  block       TcgBlock?   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  products    TcgProduct[]
  productLinks TcgProductPhysicalProduct[]

  @@unique([categoryId, blockId, name])
  @@index([categoryId])
  @@index([blockId])
}

// Una carta puede venir en varios productos físicos (kits, displays, colecciones): este enlace las une sin duplicar la carta
model TcgProductPhysicalProduct {
  productId         String
  physicalProductId Int
  product           TcgProduct         @relation(fields: [productId], references: [productId], onDelete: Cascade)
  physicalProduct   TcgPhysicalProduct @relation(fields: [physicalProductId], references: [id], onDelete: Cascade)

  @@id([productId, physicalProductId])
  @@index([physicalProductId])
}
