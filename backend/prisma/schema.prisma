// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String             @id @default(uuid())
  firebaseUid              String             @unique
  email                    String             @unique
  role                     String             @default("user")
  name                     String?
  fullName                 String?
  username                 String?            @unique
  photoURL                 String?
  bannerBase64             String?
  wallpaperBase64          String?
  bannerDominantColor      String?
  bannerComplementaryColor String?
  bio                      String?
  phone                    String?
  rut                      String?
  facebookUrl              String?
  instagramUrl             String?
  youtubeUrl               String?
  publicTheme              Json?
  addresses                Json?
  bankDetails              Json?
  folders                  Folder[]
  wishlist                 WishlistItem[]
  wishlists                Wishlist[]
  isOwner                  Boolean            @default(false) // la cuenta original de Carpetazo: nadie puede cambiar su rol, suspenderla, cerrarla ni ocultar su contenido
  lastSeenAt               DateTime? // última actividad en el chat (solo la ven quienes conversan con esta persona y si no la ocultó)
  showLastSeen             Boolean            @default(true)
  showReadReceipts         Boolean            @default(true) // si se apaga, ni esta persona ni las demás ven el ✓✓ amarillo entre ellas
  notifyWishlistEmail      Boolean            @default(true) // avisos por correo de su lista de deseos (se puede apagar desde el correo o desde la lista)
  emailVerified            Boolean            @default(false) // Firebase confirmó el correo (se actualiza al iniciar sesión); alimenta la insignia de vendedor verificado
  onboardingSharedAt       DateTime? // cuando compartió el enlace de su carpeta desde la guía de primeros pasos
  onboardingNudgeAt        DateTime? // cuando se le envió el recordatorio único de «publica tus primeras cartas»
  pushSubscriptions        PushSubscription[]
  reviewsReceived          SellerReview[]     @relation("ReviewsReceived")
  reviewsWritten           SellerReview[]     @relation("ReviewsWritten")
  reviewReports            ReviewReport[]
  reportsMade              Report[]
  feedback                 Feedback[]
  inPersonSales            InPersonSale[]
  subscriptions            Subscription[]
  planGrants               PlanGrant[]        @relation("PlanGrantUser")
  planGrantsIssued         PlanGrant[]        @relation("PlanGrantIssuer")
  sanctions                Sanction[]         @relation("SanctionsReceived")
  appeals                  Appeal[]
  moderationHidden         String[]           @default([]) // partes del perfil ocultas por moderación: photo | banner | wallpaper | text
  termsAcceptances         TermsAcceptance[]
  publicRegion             String? // región y comuna que se muestran en el perfil y permiten buscar vendedores (solo ubicación general, nunca dirección exacta)
  publicComuna             String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([publicComuna])
}

model Folder {
  totalVisits     Int      @default(0)
  weeklyVisits    Int      @default(0)
  lastVisitWeek   Int      @default(0)
  visitDays       FolderVisitDay[]
  id              String   @id @default(uuid())
  name            String
  description     String?
  tcg             String   @default("Pokemon")
  color           String   @default("red")
  isPublic        Boolean  @default(true)
  moderationState String   @default("visible") // visible | hidden | removed (lo decide moderación, no el dueño)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cards           Card[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([isPublic, createdAt])
}

model Card {
  id              String   @id @default(uuid())
  tcgId           String // The ID from the TCG API
  name            String
  imageUrl        String?
  price           Float?
  stock           Int      @default(1)
  language        String   @default("English")
  data            Json?
  moderationState String   @default("visible") // visible | image_hidden | hidden | removed
  featuredAt      DateTime? // carta destacada en el perfil público (el máximo lo fija el plan)
  folderId        String
  folder          Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([folderId])
  @@index([createdAt])
  @@index([tcgId])
  @@index([folderId, tcgId, language])
  @@index([featuredAt])
}

model Message {
  id              String            @id @default(uuid())
  senderId        String
  receiverId      String
  content         String
  moderationState String            @default("visible") // visible | hidden (no se muestra al receptor)
  isRead          Boolean           @default(false)
  deliveredAt     DateTime? // cuando la app de quien recibe lo descargó (✓✓ gris)
  readAt          DateTime? // cuando quien recibe abrió la conversación (✓✓ amarillo)
  replyToId       String? // mensaje al que responde (siempre de la misma conversación)
  forwarded       Boolean           @default(false)
  editedAt        DateTime?
  createdAt       DateTime          @default(now())
  reactions       MessageReaction[]
  stars           MessageStar[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, isRead])
}

// Una reacción por persona y mensaje
model MessageReaction {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@id([messageId, userId])
}

// Mensajes destacados: cada persona guarda los suyos (la otra no se entera)
model MessageStar {
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@id([messageId, userId])
  @@index([userId, createdAt])
}

// Contadores de actividad por día (sin datos de personas): búsquedas sin resultado, interés en los planes, compartidos, visitas al catálogo
model MetricDay {
  day   DateTime @db.Date
  name  String
  key   String   @default("")
  count Int      @default(0)

  @@id([day, name, key])
  @@index([name, day])
}

// Ajustes de cada conversación para cada persona: fijada, archivada, silenciada o marcada como no leída
model ChatSetting {
  userId       String
  partnerId    String
  pinnedAt     DateTime?
  archivedAt   DateTime?
  mutedUntil   DateTime?
  markedUnread Boolean   @default(false)
  updatedAt    DateTime  @updatedAt

  @@id([userId, partnerId])
}

model Order {
  id              String   @id @default(uuid())
  code            String?  @unique
  sellerId        String
  buyerName       String
  buyerId         String? // comprador con cuenta (pedidos por mensaje o con sesión iniciada): es quien puede calificar
  createdIpHash   String? // identificador anónimo (hash) de la conexión que creó el pedido
  completedIpHash String? // ídem, de la conexión que lo confirmó
  folderId        String
  folderName      String
  items           Json
  total           Float
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sellerId, status])
  @@index([folderId])
  @@index([buyerId])
}

model TcgCategory {
  blocks           TcgBlock[]
  categoryId       Int                  @id
  name             String
  modifiedOn       DateTime
  groups           TcgGroup[]
  physicalProducts TcgPhysicalProduct[]
}

model TcgGroup {
  blockId     Int?
  block       TcgBlock?    @relation(fields: [blockId], references: [id])
  groupId     Int          @id
  categoryId  Int
  name        String
  publishedOn DateTime
  modifiedOn  DateTime
  category    TcgCategory  @relation(fields: [categoryId], references: [categoryId])
  products    TcgProduct[]

  @@index([categoryId])
  @@index([blockId])
}

model TcgProduct {
  physicalProductId Int?
  physicalProduct   TcgPhysicalProduct?         @relation(fields: [physicalProductId], references: [id])
  productId         String                      @id
  groupId           Int
  categoryId        Int
  name              String
  cleanName         String
  imageUrl          String
  extData           Json?
  group             TcgGroup                    @relation(fields: [groupId], references: [groupId])
  physicalLinks     TcgProductPhysicalProduct[]

  @@index([groupId])
  @@index([categoryId, groupId])
  @@index([physicalProductId])
}

model TcgBlock {
  id               Int                  @id @default(autoincrement())
  categoryId       Int
  name             String
  category         TcgCategory          @relation(fields: [categoryId], references: [categoryId])
  groups           TcgGroup[]
  physicalProducts TcgPhysicalProduct[]
}

// Producto físico (kit, display, colección…) de cualquier juego: pertenece a un juego y, si el juego los usa, a un bloque
model TcgPhysicalProduct {
  id           Int                         @id @default(autoincrement())
  name         String
  releaseDate  DateTime?
  categoryId   Int
  category     TcgCategory                 @relation(fields: [categoryId], references: [categoryId])
  blockId      Int?
  block        TcgBlock?                   @relation(fields: [blockId], references: [id], onDelete: SetNull)
  products     TcgProduct[]
  productLinks TcgProductPhysicalProduct[]

  @@unique([categoryId, blockId, name])
  @@index([categoryId])
  @@index([blockId])
}

// Una carta puede venir en varios productos físicos (kits, displays, colecciones): este enlace las une sin duplicar la carta
model TcgProductPhysicalProduct {
  productId         String
  physicalProductId Int
  product           TcgProduct         @relation(fields: [productId], references: [productId], onDelete: Cascade)
  physicalProduct   TcgPhysicalProduct @relation(fields: [physicalProductId], references: [id], onDelete: Cascade)

  @@id([productId, physicalProductId])
  @@index([physicalProductId])
}

// Catálogo de TCGplayer (todos los juegos menos Mitos y Leyendas, que tiene el suyo arriba). Lo carga la pantalla de moderación
// con los archivos que exporta TcgplayerUpdate. Los ids son los de TCGplayer; las imágenes viven en R2 y aquí solo se guarda su ruta.
model CatalogGame {
  categoryId Int           @id
  name       String
  folder     String
  updatedAt  DateTime      @updatedAt
  sets       CatalogSet[]
  cards      CatalogCard[]
}

model CatalogSet {
  groupId      Int           @id
  categoryId   Int
  game         CatalogGame   @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  name         String
  folder       String
  abbreviation String?
  publishedOn  DateTime?
  modifiedOn   DateTime?
  cards        CatalogCard[]

  @@index([categoryId])
}

model CatalogCard {
  productId      Int         @id
  categoryId     Int
  game           CatalogGame @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade)
  groupId        Int
  set            CatalogSet  @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  kind           String // card | product
  name           String
  cleanName      String
  number         String?
  rarity         String?
  folder         String
  imageKey       String?
  thumbKey       String?
  dataKey        String?
  sourceImageUrl String?
  tcgplayerUrl   String?
  attributes     Json?
  modifiedOn     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([categoryId, groupId])
  @@index([groupId])
  @@index([categoryId, kind, cleanName])
}

// Corridas de la sincronización nocturna con TCGplayer: sirven de candado (una a la vez) y de historial
model CatalogSyncRun {
  id         String    @id @default(uuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String // running | ok | partial | failed
  dryRun     Boolean   @default(false)
  summary    Json?
}

// Correcciones que TCGplayer hizo a una carta que ya está en el catálogo: se guardan para revisarlas a mano, la sincronización no las aplica
model CatalogChange {
  id         String   @id @default(uuid())
  productId  Int
  categoryId Int
  groupId    Int
  digest     String
  before     Json
  after      Json
  status     String   @default("pending") // pending | accepted | rejected
  createdAt  DateTime @default(now())

  @@unique([productId, digest])
  @@index([status, createdAt])
}

// Foto que una persona subió a una carta del catálogo que no tenía imagen: Moderación decide si pasa a ser la imagen de esa carta para todos.
// La foto se copia a Carpetazo.cl/Propuestas/ al proponerla, así sigue disponible aunque la persona cambie o borre la suya.
model CatalogImageProposal {
  id          String    @id @default(uuid())
  productId   Int
  userId      String
  imageKey    String // copia en R2 mientras está pendiente
  status      String    @default("pending") // pending | approved | rejected | closed
  note        String?
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@unique([productId, userId])
  @@index([status, createdAt])
  @@index([productId, status])
  @@index([userId, createdAt])
}

// Cartas que un jugador busca. Se enlazan con el catálogo cuando existen allí; si no, se guardan con su nombre.
// Listas de deseos de una persona: una sola está activa y es la que se muestra en su perfil (índice único parcial en la migración)
model Wishlist {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean        @default(false)
  createdAt DateTime       @default(now())
  items     WishlistItem[]

  @@index([userId, createdAt])
}

model WishlistItem {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistId      String
  wishlist        Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  categoryId      Int?
  productId       String?
  name            String
  game            String?
  detail          String?
  imageUrl        String?
  quantity        Int      @default(1)
  maxPrice        Float?
  priceVisible    Boolean  @default(false)
  note            String?
  moderationState String   @default("visible") // visible | hidden
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  alertState WishlistAlertState?

  @@unique([wishlistId, productId])
  @@index([userId, createdAt])
}

// Último estado visto de cada carta deseada (precio más bajo publicado dentro de su precio máximo): para avisar solo cuando aparece o baja
model WishlistAlertState {
  itemId     String       @id
  item       WishlistItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId     String
  lastPrice  Float?
  notifiedAt DateTime?
  updatedAt  DateTime     @updatedAt

  @@index([userId, notifiedAt])
}

// Dispositivo de una persona que aceptó notificaciones del navegador (Web Push)
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Reseña de un comprador a un vendedor por un pedido completado. Una por pedido y no se edita.
model SellerReview {
  id         String         @id @default(uuid())
  sellerId   String
  seller     User           @relation("ReviewsReceived", fields: [sellerId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User           @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  orderId    String         @unique
  rating     Int
  comment    String?
  counts     Boolean        @default(true) // false: no se muestra ni promedia (sospechosa o reportada)
  flag       String? // same_connection | reported
  reports    ReviewReport[]
  createdAt  DateTime       @default(now())

  @@unique([sellerId, reviewerId]) // una reseña por pareja comprador-vendedor
  @@index([sellerId, createdAt])
  @@index([reviewerId])
}

// Denuncia de una reseña: mientras esté reportada deja de contar hasta que se revise
model ReviewReport {
  id         String       @id @default(uuid())
  reviewId   String
  review     SellerReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     String?
  createdAt  DateTime     @default(now())

  @@unique([reviewId, reporterId])
  @@index([reviewId])
}

// Aceptación de los Términos y Condiciones y de la Política de Privacidad (una fila por versión aceptada)
model TermsAcceptance {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  termsVersion   String
  privacyVersion String
  isAdult        Boolean   @default(true) // declaró tener 18 años o más
  connectionHash String? // hash de la conexión (con sal), no la IP
  acceptedAt     DateTime  @default(now())
  // Evidencia para una eventual defensa legal (nunca se borra al reactivar una cuenta: se anula)
  voidedAt       DateTime? // aceptación anterior a que la cuenta se borrara y reactivara: ya no rige
  method         String? // cómo inició sesión: google.com | password
  userAgent      String? // navegador/dispositivo informado por el navegador (máx. 300)
  emailHash      String? // HMAC del correo con la sal del servidor: comprueba un correo sin guardarlo

  @@index([userId, acceptedAt])
  @@index([emailHash])
}

// Reporte genérico de contenido (usuarios, perfil, carpetas, cartas, fotos, reseñas, mensajes, lista de deseos)
model Report {
  id            String     @id @default(uuid())
  shortCode     String     @unique // "RP-4F9K2": seguimiento
  targetType    String
  targetId      String
  targetOwnerId String? // dueño del contenido, lo decide el servidor
  reasonCode    String // ej. "card_image.sexual_explicit"
  severity      String // S1 | S2 | S3 | S4, copiado del catálogo
  comment       String?
  extra         Json?
  reporterId    String? // null: lo detectó el sistema (filtros de texto)
  reporter      User?      @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  weight        Float      @default(1) // reputación de quien reportó al momento de hacerlo
  snapshot      Json // instantánea al reportar: borrar o editar no destruye la prueba
  status        String     @default("open") // open | dismissed | actioned
  decision      String? // dismiss | hide | remove | restore
  decisionNote  String? // nota interna
  decidedById   String?
  decidedAt     DateTime?
  autoActioned  Boolean    @default(false) // true si el sistema ocultó el contenido antes de revisión
  reporterRole  String? // buyer | seller | visitor (en reportes de pedido)
  caseId        String? // caso de estafa al que se unió
  evidence      Evidence[]
  createdIpHash String?
  createdAt     DateTime   @default(now())

  @@unique([reporterId, targetType, targetId, reasonCode])
  @@index([targetType, targetId])
  @@index([targetOwnerId, createdAt])
  @@index([status, severity, createdAt])
}

// Registro de acciones de moderación: solo se agrega, nunca se edita
model ModerationAudit {
  id         String   @id @default(uuid())
  actorId    String?
  action     String // decision.dismiss | decision.hide | decision.remove | decision.restore | note | auto.hide
  targetType String?
  targetId   String?
  reportId   String?
  note       String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([reportId])
}

// Medida contra una cuenta. El estado vigente de la cuenta sale de las sanciones activas.
model Sanction {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation("SanctionsReceived", fields: [userId], references: [id], onDelete: Cascade)
  type         String // warning | restrict_messages | suspend_selling | suspend | ban
  reason       String // texto que ve la persona
  note         String? // nota interna
  reportId     String?
  caseId       String?
  status       String    @default("active") // pending_approval | active | revoked | expired | rejected
  automatic    Boolean   @default(false) // la aplicó el sistema (reversible)
  expiresAt    DateTime?
  createdById  String?
  approvedById String? // segunda aprobación (baneo permanente)
  revokedById  String?
  revokedAt    DateTime?
  revokeNote   String?
  createdAt    DateTime  @default(now())
  appeals      Appeal[]

  @@index([userId, status])
  @@index([status, expiresAt])
}

// Apelación de quien recibió una sanción o una medida sobre su contenido
model Appeal {
  id           String    @id @default(uuid())
  sanctionId   String?
  sanction     Sanction? @relation(fields: [sanctionId], references: [id], onDelete: Cascade)
  reportId     String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String
  status       String    @default("open") // open | accepted | rejected
  decidedById  String?
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@unique([sanctionId])
  @@unique([reportId, userId])
  @@index([status, createdAt])
}

// Caso de estafa: agrupa los reportes contra un mismo vendedor y lleva el descargo
model FraudCase {
  id                String    @id @default(uuid())
  shortCode         String    @unique // "CS-81KD2"
  subjectUserId     String
  status            String    @default("open") // open | awaiting_response | in_review | resolved
  priority          String    @default("normal") // normal | high
  responseDueAt     DateTime?
  sellerResponse    String?
  sellerRespondedAt DateTime?
  resolution        String? // dismissed | warned | restricted | suspended | escalated
  resolutionNote    String?
  resolvedById      String?
  resolvedAt        DateTime?
  openedAt          DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([subjectUserId, status])
  @@index([status, priority, openedAt])
}

// Evidencia de un reporte (capturas, comprobantes): se guarda en la base y solo la ve el equipo de moderación
model Evidence {
  id        String   @id @default(uuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mime      String
  size      Int
  sha256    String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([reportId])
}

// Bloqueo entre usuarios: quien es bloqueado no puede escribirle a quien bloqueó
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Huella visual (dHash) de cada imagen subida: si una imagen se confirma como infracción, la huella queda prohibida
model ImageHash {
  id        String    @id @default(uuid())
  url       String    @unique
  hash      String // 16 caracteres hexadecimales (64 bits)
  sha256    String? // huella exacta del archivo original (caché de veredictos)
  verdict   String? // clear | review | block | unscanned | pending (resultado del escaneo)
  provider  String? // sightengine | google | null
  userId    String?
  banned    Boolean   @default(false)
  bannedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([banned])
  @@index([createdAt])
  @@index([sha256])
}

// Uso mensual de cada servicio de escaneo de imágenes (para no pasarse de la cuota gratuita)
model ScanUsage {
  provider  String
  month     String // "2026-10" (UTC)
  used      Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([provider, month])
}

// Un registro por escaneo (o por acierto de caché): alimenta las métricas
model ScanEvent {
  id        String   @id @default(uuid())
  provider  String // sightengine | google | cache | none
  kind      String // profile | card
  verdict   String // clear | review | block | unavailable
  fallback  Boolean  @default(false) // se usó un proveedor de respaldo porque el principal no estaba disponible
  ms        Int      @default(0)
  detail    String? // qué pasó con cada proveedor, p. ej. "sightengine:timeout,google:auth"
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Precio más bajo publicado de cada carta, una vez al día: es el historial que se muestra en la página de la carta
model CardPriceSnapshot {
  id     String   @id @default(uuid())
  tcg    String
  tcgId  String
  day    DateTime @db.Date
  lowest Float
  offers Int

  @@unique([tcg, tcgId, day])
  @@index([day])
}

// Precio de mercado de TCGplayer (en pesos) de las cartas de Pokémon a la venta, una vez al día
model CardMarketSnapshot {
  id    String   @id @default(uuid())
  tcgId String
  day   DateTime @db.Date
  clp   Float
  usd   Float

  @@unique([tcgId, day])
  @@index([day])
}

// Errores del servidor y de la web agrupados por huella (sin datos personales): los ve el equipo en Moderación → Operación
model ErrorEvent {
  id          String   @id @default(uuid())
  fingerprint String   @unique
  kind        String // server | client | http
  message     String
  route       String?
  stack       String?
  count       Int      @default(1)
  firstSeen   DateTime @default(now())
  lastSeen    DateTime @default(now())

  @@index([lastSeen])
}

// Quejas y sugerencias enviadas por las personas; el equipo puede marcarlas como corregidas.
model Feedback {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          String // complaint | suggestion | support
  title         String
  message       String
  attachments   Json      @default("[]")
  status        String    @default("open") // open | corrected
  priority      Boolean   @default(false)
  moderatorNote String?
  correctedById String?
  correctedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([priority, status, createdAt])
  @@index([userId, createdAt])
}

// Venta presencial que el dueño registra de su carpeta: baja el stock y queda en su historial.
// Es una declaración propia: nunca entra al precio de mercado ni a «Últimas ventas» (esas leen solo pedidos completados).
// folderId sin relación para conservar el historial aunque se borre la carpeta; requestId evita registrar dos veces el mismo envío.
model InPersonSale {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  folderId   String
  folderName String
  requestId  String
  items      Json
  units      Int
  total      Float
  subtotal   Float?
  adjustmentType  String?
  adjustmentValue Float?
  discountAmount  Float?
  createdAt  DateTime @default(now())

  @@unique([userId, requestId])
  @@index([userId, createdAt])
  @@index([folderId, createdAt])
}

// Suscripción comercial. El precio se copia al contratar para conservar el historial aunque cambie el catálogo.
model Subscription {
  id                     String                @id @default(uuid())
  userId                 String
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey                String
  status                 String                @default("pending") // pending | active | past_due | paused | canceled | expired
  provider               String                @default("mercadopago")
  providerSubscriptionId String?               @unique
  providerPlanId         String?
  priceClp               Int
  currency               String                @default("CLP")
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  nextPaymentAt          DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  canceledAt             DateTime?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  payments               SubscriptionPayment[]
  events                 BillingEvent[]

  @@index([userId, status])
  @@index([planKey, status])
}

model SubscriptionPayment {
  id                String        @id @default(uuid())
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  providerPaymentId String        @unique
  status            String
  amountClp         Int
  currency          String        @default("CLP")
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([subscriptionId, createdAt])
}

// Eventos externos idempotentes: un webhook repetido nunca aplica dos veces el mismo cambio.
model BillingEvent {
  id              String        @id @default(uuid())
  provider        String        @default("mercadopago")
  providerEventId String
  topic           String
  resourceId      String?
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  status          String        @default("received") // received | processed | ignored | failed
  attempts        Int           @default(0)
  error           String?
  payloadHash     String?
  receivedAt      DateTime      @default(now())
  processedAt     DateTime?

  @@unique([provider, providerEventId])
  @@index([status, receivedAt])
}

// Plan temporal entregado por administración o por el modo de prueba local.
model PlanGrant {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("PlanGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  planKey     String
  reason      String
  startsAt    DateTime  @default(now())
  endsAt      DateTime?
  revokedAt   DateTime?
  grantedById String?
  grantedBy   User?     @relation("PlanGrantIssuer", fields: [grantedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([userId, startsAt, endsAt])
}

// Visitas de cada carpeta pública por día (hora de Chile) y origen: es el «detalle de visitas» de los planes Premium en adelante.
// Se guarda siempre; el plan solo decide quién lo puede ver. Se borra pasados los días de retención.
model FolderVisitDay {
  folderId String
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  source   String // direct | internal | external
  count    Int      @default(0)

  @@id([folderId, day, source])
  @@index([day])
}
